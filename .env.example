# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/school_erp?schema=public"

# Redis (Caching, Domain Resolution, Rate Limiting & BullMQ)
REDIS_URL="redis://localhost:6379"

# Authentication & Security (256-bit secret)
JWT_SECRET="school-erp-super-secure-jwt-secret-min-32-chars-long"
JWT_REFRESH_SECRET="school-erp-super-secure-refresh-jwt-secret-32-chars"

# Razorpay India (Fee Collection & Online Settlement)
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# Meta WhatsApp Cloud API (Primary Parent Notifications)
WHATSAPP_API_TOKEN="your-meta-whatsapp-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"

# SMS Fallback (Msg91 / Fast2SMS DLT Compliant)
MSG91_AUTH_KEY="your-msg91-auth-key"
MSG91_SENDER_ID="SCHLRP"

# Domain & Platform Configuration
NEXT_PUBLIC_APP_DOMAIN="schoolerp.in"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="School ERP"
NODE_ENV="development"
