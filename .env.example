# ==============================================================================
# SCHOOL MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Multi-Tenant SaaS Platform for Indian K-12 Schools
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env in your deployment or local development environment:
#    cp .env.example .env
# 2. Fill in all REQUIRED secrets. In production, missing secrets will fail closed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Environment mode: 'development' | 'test' | 'production'
NODE_ENV="development"

# Skip env schema validation during build (only use in CI/CD pipeline if needed)
SKIP_ENV_VALIDATION="false"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string with connection pooling (PgBouncer recommended in production)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_erp?schema=public"

# ------------------------------------------------------------------------------
# 3. REDIS & CACHE CONFIGURATION
# ------------------------------------------------------------------------------
# Redis connection URL for session caches, rate limiting, and OTP stores
# Format: redis://:[password]@[host]:[port]
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & JWT SECURITY (CRITICAL)
# ------------------------------------------------------------------------------
# High-entropy signing secret for session tokens (HS256, minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-random-32-character-secret-in-production"

# High-entropy signing secret for refresh tokens (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_REFRESH_SECRET="replace-with-a-random-32-character-refresh-secret-prod"

# ------------------------------------------------------------------------------
# 5. PUBLIC PLATFORM DOMAIN & BRANDING
# ------------------------------------------------------------------------------
# Primary application domain for tenant resolution and multi-tenant subdomains
NEXT_PUBLIC_APP_DOMAIN="localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="School ERP"

# Demo Mode toggle (displays pre-filled test login credentials on /login)
# MUST BE FALSE IN PRODUCTION
NEXT_PUBLIC_DEMO_MODE="false"

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# Razorpay API credentials for Indian fee collections (Cards, UPI, NetBanking)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# ------------------------------------------------------------------------------
# 7. COMMUNICATIONS & NOTIFICATION GATEWAYS (SMS / WhatsApp)
# ------------------------------------------------------------------------------
# Meta Cloud API for automated WhatsApp parent alerts
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# MSG91 or Fast2SMS transactional DLT credentials
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="SCHLRP"

# ------------------------------------------------------------------------------
# 8. CLERK AUTHENTICATION (Alpha Edu Hub)
# ------------------------------------------------------------------------------
# Obtain from Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder_key"
CLERK_SECRET_KEY="sk_test_placeholder_secret"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"
CLERK_WEBHOOK_SECRET="whsec_placeholder_webhook_secret"

