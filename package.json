{
  "name": "school-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Tenant School ERP & White-Label CMS Platform for Indian K-12 Schools",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
