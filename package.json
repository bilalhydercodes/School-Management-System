    "bullmq": "^5.12.9",
    "clsx": "^2.1.1",
    "dompurify": "^3.1.6",
    "exceljs": "^4.4.0",
    "ioredis": "^5.4.1",
    "jose": "^5.8.0",
    "lucide-react": "^0.428.0",
    "next": "14.2.35",
    "nodemailer": "^10.0.13",
    "razorpay": "^2.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
