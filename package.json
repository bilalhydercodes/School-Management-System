    "db:seed": "ts-node prisma/seed.ts",
    "worker": "tsx src/workers/notification.worker.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^5.7.6",
    "@prisma/client": "^5.18.0",
    "@t3-oss/env-nextjs": "^0.10.1",
